# Copy to .env and fill in. Bun loads .env automatically for bun scripts.

# Two throwaway accounts for the Base Sepolia deployment (chain 84532).
# Generate fresh keys; NEVER reuse the local-dev Hardhat keys on a public
# network. Only the deployer needs faucet funding — scripts/seed-base-sepolia.ts
# forwards gas money to the auditor itself.
DEPLOYER_PRIVATE_KEY=
AUDITOR_PRIVATE_KEY=

# Optional: any Base Sepolia JSON-RPC endpoint (Infura/Alchemy key or the
# public endpoint below).
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
